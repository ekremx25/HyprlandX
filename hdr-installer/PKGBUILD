# Tested source base: upstream Hyprland v0.57.1 + HDR fix 4.
pkgname=hyprland
pkgver=0.57.1.hdrfix4
pkgrel=2
pkgdesc='Hyprland with HDR video and BT.1886 color fixes'
arch=('x86_64')
url='https://github.com/hyprwm/Hyprland'
license=('BSD-3-Clause')
depends=(cairo aquamarine libgcc libstdc++ glibc glib2 glslang hyprcursor hyprgraphics hyprland-guiutils hyprlang hyprutils hyprwire lcms2 libcanberra libdrm libei libglvnd libinput libx11 libxcb libxcomposite libxcursor libxfixes libxkbcommon libxrender lua mesa muparser opengl-driver pango pixman re2 sdbus-cpp tomlplusplus util-linux-libs wayland wayland-protocols xcb-proto xcb-util xcb-util-errors xcb-util-image xcb-util-keysyms xcb-util-renderutil xcb-util-wm xorg-xwayland)
makedepends=(git cmake ninja gcc pkgconf hyprwayland-scanner hyprland-protocols)
provides=('wayland-compositor')
options=('!debug' '!lto')
source=('hyprland-source::git+https://github.com/hyprwm/Hyprland.git#commit=acc1aa0bfd4bd575dcb0f76c35ccf12b660a1ab9'
        'patches/01-hdr.patch' 'patches/02-bt1886.patch' 'patches/03-sdr-mapping.patch')
sha256sums=('SKIP' '5cbf33d58c10ad04f3d75bb40b1f0d5a4c975533013dd7cbfae1bda3738d9ce2' 'dc084434ab57487e3a259fae89f8e6caee6b4e51e829e2af327141c520d83747' 'ce303dfa58c7b3854f65526c7b05cc9e1a95b766e87ba71e2cb3ff72540cbd5f')

prepare() {
    cd "$srcdir/hyprland-source"
    [[ $(git rev-parse HEAD) == acc1aa0bfd4bd575dcb0f76c35ccf12b660a1ab9 ]] || return 1
    [[ $(cat VERSION) == 0.57.1 ]] || return 1
    git submodule update --init subprojects/udis86
    local patch_file
    for patch_file in 01-hdr.patch 02-bt1886.patch 03-sdr-mapping.patch; do
        git apply --check "$srcdir/$patch_file" || return 1
        git apply "$srcdir/$patch_file" || return 1
    done
}

build() {
    cmake -S "$srcdir/hyprland-source" -B "$srcdir/build" -G Ninja         -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr         -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_TESTING=OFF -DWITH_TESTS=OFF
    cmake --build "$srcdir/build" --parallel "${HDR_JOBS:-2}"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
    install -Dm644 "$srcdir/hyprland-source/LICENSE" "$pkgdir/usr/share/licenses/hyprland/LICENSE"
}
