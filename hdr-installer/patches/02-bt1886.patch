+TEST(ColorManagement, BT1886UsesDisplayGammaInsteadOfCameraCurve) {
+    const auto source = CImageDescription::from(SImageDescription{
+        .transferFunction = CM_TRANSFER_FUNCTION_BT1886,
+        .primariesNameSet = true,
+        .primariesNamed   = CM_PRIMARIES_SRGB,
+        .luminances       = {.min = 0.01f, .max = 100, .reference = 100},
+    });
+    for (const double value : {0.0, 0.05, 0.18, 0.5, 1.0}) {
+        const auto decoded = convertWithoutTonemapping({{.r = value, .g = value, .b = value, .a = 1.0}}, source, LINEAR_NN_IMAGE_DESCRIPTION);
+        expectNeutralColor(decoded, 0.01 + 99.99 * std::pow(value, 2.4));
+        const auto encoded = convertWithoutTonemapping(decoded, LINEAR_NN_IMAGE_DESCRIPTION, source);
+        expectNeutralColor(encoded, value);
+    }
+}
