+TEST_F(CRenderLifecycleTest, BT1886VideoUsesConfiguredSDRWhiteOnHDRDisplay) {
+    using namespace NColorManagement;
+    auto& ctx                     = renderer().context();
+    ctx.m_data.pMonitor           = m_monitor;
+    m_monitor->m_imageDescription = DEFAULT_HDR_IMAGE_DESCRIPTION;
+    m_monitor->m_sdrBrightness    = 1.2f;
+    m_monitor->m_sdrSaturation    = 1.1f;
+    auto desc                     = DEFAULT_SRGB_IMAGE_DESCRIPTION->value();
+    desc.transferFunction         = CM_TRANSFER_FUNCTION_BT1886;
+    desc.luminances               = {.min = 0.01f, .max = 100, .reference = 100};
+    const auto source             = CImageDescription::from(desc);
+    for (const auto target : {LINEAR_IMAGE_DESCRIPTION, DEFAULT_HDR_IMAGE_DESCRIPTION}) {
+        renderer().clearCMSettingsCache(ctx);
+        const auto settings = renderer().getCMSettings(ctx, source, target, nullptr, true, 0.2f, 297);
+        EXPECT_EQ(settings.sourceTF, CM_TRANSFER_FUNCTION_BT1886);
+        EXPECT_FLOAT_EQ(settings.srcTFRange.min, 0.2f);
+        EXPECT_FLOAT_EQ(settings.srcTFRange.max, 297.f);
+        EXPECT_TRUE(settings.needsSDRmod);
+        EXPECT_FLOAT_EQ(settings.sdrBrightnessMultiplier, 1.2f);
+        EXPECT_FLOAT_EQ(settings.sdrSaturation, 1.1f);
+    }
+    renderer().clearCMSettingsCache(ctx);
+    const auto unmodified = renderer().getCMSettings(ctx, source, LINEAR_IMAGE_DESCRIPTION, nullptr, false, 0.2f, 297);
+    EXPECT_FALSE(unmodified.needsSDRmod);
+    EXPECT_FLOAT_EQ(unmodified.srcTFRange.min, 0.01f);
+    EXPECT_FLOAT_EQ(unmodified.srcTFRange.max, 100.f);
+    renderer().clearCMSettingsCache(ctx);
+    const auto sdr = renderer().getCMSettings(ctx, source, DEFAULT_SRGB_IMAGE_DESCRIPTION, nullptr, true, 0.2f, 297);
+    EXPECT_FALSE(sdr.needsSDRmod);
+    EXPECT_FLOAT_EQ(sdr.srcTFRange.max, 100.f);
+}
